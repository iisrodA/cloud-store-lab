# Local development variables. In App Engine, values come from app.yaml instead.
APP_ENV=development
PORT=8000

# --- Cloud SQL (PostgreSQL) ---
# Local: point DB_HOST to localhost (using Cloud SQL Auth Proxy) or a public IP.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudgames
DB_USER=postgres
DB_PASSWORD=postgres

# Production: leave DB_HOST empty and set INSTANCE_CONNECTION_NAME instead.
# Format: PROJECT_ID:REGION:INSTANCE_NAME
INSTANCE_CONNECTION_NAME=

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
FIRESTORE_COLLECTION_AUDIT_EVENTS=audit_events

# Path to a service account JSON file (local only — App Engine uses the default SA).
GOOGLE_APPLICATION_CREDENTIALS=
